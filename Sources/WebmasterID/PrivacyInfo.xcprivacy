<?xml version="1.0" encoding="UTF-8"?>
<!--
  WebmasterID Swift SDK — Apple privacy manifest.

  ═══════════════════════════════════════════════════════════════════════════
  EVERY ENTRY BELOW WAS DERIVED FROM THE CODE, NOT FROM A TEMPLATE
  ═══════════════════════════════════════════════════════════════════════════

  NSPrivacyTracking is false and there are no tracking domains, because the
  SDK performs no cross-app or cross-website linking: it has no advertising
  identifier, no IDFV, no AppTrackingTransparency, no data-broker integration
  and no shared identifier of any kind. Its only identifiers are an app-local
  random installation id and an account key the host application supplies.

  NSPrivacyAccessedAPITypes is EMPTY, and that was audited rather than assumed.
  The library touches FileManager (directory creation, existence, removal),
  Data read/write, Keychain SecItem*, URLSession, ISO8601DateFormatter and
  SystemRandomNumberGenerator. None of those is on Apple's required-reason
  list. Specifically absent, each checked by name: UserDefaults, file
  timestamps (creationDate / modificationDate / stat / getattrlist), system
  boot time (systemUptime / mach_absolute_time), disk space
  (volumeAvailableCapacity / statfs) and active keyboards.

  ⚠ SYSTEM BOOT TIME IS ABSENT ON PURPOSE, NOT BY LUCK. The `uptime_delta_ms`
  field was deliberately deferred while the Apple 35F9.1 question is open, and
  no system-uptime substitute was quietly used in its place. Adding one would
  require a reason code here.

  COARSE LOCATION IS DECLARED, AND THE REASONING IS OPEN TO CHALLENGE.
  The SDK reads no location and sends no location field — it has none. The
  RECEIVING SERVER derives a country code from the connection's IP address and
  RETAINS it alongside the pseudonymous identifiers. Because it is retained
  rather than used only to service the request in real time, it is declared.
  Region, city and precise coordinates are neither collected nor derived, and
  are deliberately not listed. A reviewer who concludes IP-derived country need
  not be declared would be disagreeing with a stated argument rather than with
  a silence, which is the point of writing it down.
-->
<plist version="1.0">
<dict>
  <key>NSPrivacyTracking</key>
  <false/>

  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <key>NSPrivacyAccessedAPITypes</key>
  <array/>

  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <!-- Event names, screen identifiers, app version/build, OS major, locale
         and timezone. What the person did in the app, coarsely. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeProductInteraction</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>

    <!-- The installation identifier: 128 random bits, app-local, resettable,
         created only under `analyticsAllowed` consent. It is NOT the
         advertising identifier and NOT identifierForVendor — neither is
         referenced anywhere in the SDK — but it is a device-scoped identifier
         and is declared as one. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeDeviceID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>

    <!-- The account key the host application passes to `identify`. Optional,
         permitted only under `analyticsAllowed`, refused outright if it looks
         like an email address, and hashed server-side before storage. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeUserID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>

    <!-- Country only, derived server-side from the connection. See the header
         comment: region, city and coordinates are absent. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCoarseLocation</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
